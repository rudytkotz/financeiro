{
  "name": "controle-financeiro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/backend",
    "packages/frontend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w packages/backend\" \"npm run dev -w packages/frontend\"",
    "build": "npm run build -w packages/shared && npm run build -w packages/backend && npm run build -w packages/frontend",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"packages/**/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/**/src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p packages/backend --noEmit && tsc -p packages/frontend --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^3.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fast-check": "^3.19.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  }
}
