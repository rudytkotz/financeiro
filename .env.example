# Ambiente: development | test | production
NODE_ENV=development

# Banco de dados (obrigatório)
DATABASE_URL=postgresql://user:password@localhost:5432/controle_financeiro

# Servidor
PORT=3000
HOST=0.0.0.0

# Autenticação — obrigatório em produção
JWT_SECRET=change-this-in-production

# Origem do frontend permitida no CORS em produção (ex: https://app.exemplo.com)
FRONTEND_URL=

# Integrações opcionais
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
BRAPI_TOKEN=your-brapi-token-here
